# Spring Boot 起動用（application.properties から抽出）
# 使い方: cp .env.example .env に値を入れ、下記 export コマンドで読み込む
#   set -a && source .env && set +a

# --- 必須（デフォルト値なし） ---

# Supabase → Project Settings → Database → Connection string (URI)
# 例: jdbc:postgresql://db.xxxxx.supabase.co:5432/postgres?sslmode=require
DB_URL=

# Supabase Database のユーザー名（通常 postgres）
DB_USERNAME=

# Supabase Database のパスワード
DB_PASSWORD=

# Supabase → Project Settings → API → Project URL
# 例: https://xxxxx.supabase.co
SUPABASE_URL=

# Supabase → Project Settings → API → service_role key（フロントに渡さないこと）
SUPABASE_SERVICE_ROLE_KEY=

# --- 任意（application.properties にデフォルトあり） ---

# JWT 署名用シークレット（未設定時: dev-only-secret-change-me-before-deploy-0123456789）
# JWT_SECRET=

# 招待 URL 生成用フロント URL（未設定時: http://localhost:3000）
# FRONTEND_BASE_URL=http://localhost:3000

# Storage バケット名（未設定時: shiori-photos）
# SUPABASE_STORAGE_BUCKET=shiori-photos
